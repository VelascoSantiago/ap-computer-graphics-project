        </mxCell>
        <mxCell id="c21" value="&lt;div&gt;glfwSwapBuffers(window)&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;fontSize=19;fontColor=#12263E;fillColor=#EAF2FB;strokeColor=#81A7CF;strokeWidth=2;fontStyle=1;rounded=1;arcSize=12;spacingLeft=15;spacingRight=15;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
