        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;CONFIGURACIÓN INICIAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Las rutas de los recursos son relativas.&lt;br/&gt;Shader/lighting.vs y lighting.frag;&lt;br/&gt;Model carga archivos OBJ mediante&lt;br/&gt;Assimp y sus materiales.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=17;fontColor=#455B75;fillColor=#F2F6FA;strokeColor=#E5EBF3;strokeWidth=2;rounded=1;arcSize=8;spacingLeft=20;spacingRight=18;spacingTop=15;spacingBottom=15;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="91" y="678" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;CONTROLES DURANTE EL CICLO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Teclado y ratón actualizan la cámara&lt;br/&gt;y los modelos. N, B y V cambian&lt;br/&gt;los estados de las tres animaciones.&lt;br/&gt;El procesamiento ocurre por fotograma.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=17;fontColor=#455B75;fillColor=#F2F6FA;strokeColor=#E5EBF3;strokeWidth=2;rounded=1;arcSize=8;spacingLeft=20;spacingRight=18;spacingTop=15;spacingBottom=15;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1114" y="900" width="450" height="183" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;DIBUJO DE SENTINEL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Para i = 0, 1 y 2 se calcula el barrido,&lt;br/&gt;retroceso y posible destello. Una única&lt;br/&gt;luz puntual representa el primer&lt;br/&gt;destello activo del fotograma.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=16;fontColor=#455B75;fillColor=#F2F6FA;strokeColor=#E5EBF3;strokeWidth=2;rounded=1;arcSize=8;spacingLeft=20;spacingRight=18;spacingTop=15;spacingBottom=15;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1114" y="1435" width="450" height="167" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b&gt;ORDEN DEL FOTOGRAMA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;El programa actualiza el tiempo,&lt;br/&gt;procesa eventos y animaciones&lt;br/&gt;antes de configurar la iluminación&lt;br/&gt;y emitir las llamadas de dibujo.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=16;fontColor=#455B75;fillColor=#F2F6FA;strokeColor=#E5EBF3;strokeWidth=2;rounded=1;arcSize=8;spacingLeft=20;spacingRight=18;spacingTop=15;spacingBottom=15;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1520" width="322" height="163" as="geometry" />
        </mxCell>
