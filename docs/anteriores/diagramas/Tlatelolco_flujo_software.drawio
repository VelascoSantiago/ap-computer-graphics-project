        <mxCell id="c20" value="&lt;div&gt;Dibujar plaza, CUAU, 3 SENTINEL + railguns&lt;br/&gt;MAC y sus 3 sierras (matrices individuales)&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;fontSize=17;fontColor=#12263E;fillColor=#DDF4EF;strokeColor=#51A992;strokeWidth=2;fontStyle=1;rounded=1;arcSize=12;spacingLeft=15;spacingRight=15;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
